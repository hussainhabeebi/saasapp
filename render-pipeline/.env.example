# Required — must be the EXACT same value as the Worker's MARKETING_RENDER_WEBHOOK_SECRET
# secret (cloudflare-worker/wrangler.toml). Generate once with: openssl rand -hex 32
RENDER_WEBHOOK_SECRET=

# Required for transcription (POST /transcribe, lib/transcribe.js) — the OpenAI key used to call
# the Whisper API. Lives HERE, not on the Worker: OpenAI blocks requests from source IPs in
# certain countries/regions, and Cloudflare Workers' globally-distributed edge network has an
# unpredictable egress IP per request, which can (and did) trigger that block even for accounts in
# supported regions. This server runs on one fixed host instead, so its egress IP is stable.
MARKETING_TRANSCRIBE_API_KEY=
# Optional override, e.g. for an OpenAI-compatible self-hosted Whisper endpoint.
# MARKETING_TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions

# Optional but recommended for Malayalam/Hindi/Tamil/Telugu/Kannada/Bengali/Marathi/Gujarati/
# Punjabi/Odia projects — routes transcription for those languages through Sarvam AI
# (docs.sarvam.ai) instead of Whisper, which turned out to have weak real-world Malayalam
# accuracy. Same key as this app's existing Sarvam TTS integration if you already have one; get
# one at https://www.sarvam.ai if not. See lib/sarvamTranscribe.js's header comment for what is
# and isn't verified about this integration.
# SARVAM_API_KEY=

PORT=8787

# --- Output storage: pick ONE of the two options below ---

# Option A (recommended) — upload rendered clips straight into the same R2 bucket the Worker
# already serves from (MARKETING_MEDIA / leadvyne-marketing-media), via R2's S3-compatible API.
# Create a token: Cloudflare dashboard -> R2 -> Manage API Tokens -> Create API Token
# (Object Read & Write, scoped to the leadvyne-marketing-media bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=leadvyne-marketing-media

# Option B — skip R2 entirely and serve rendered files from this same process instead (useful for
# local testing without a Cloudflare account). Leave the R2_* vars above blank to activate this.
# LOCAL_PUBLIC_BASE_URL must be reachable from wherever the Worker's browser clients load videos
# from (not just from this server itself).
# LOCAL_PUBLIC_BASE_URL=https://your-render-host.example.com/public
# LOCAL_PUBLIC_DIR=/app/public

# Optional — where to look for bring-your-own B-roll/SFX/music (see assets/*/README.md).
# Defaults to ./assets next to this file.
# ASSETS_ROOT=/app/assets

# Optional — when a suggested B-roll cue has no matching file in assets/broll/, fetch a relevant
# royalty-free clip from Pexels' free stock video API instead of silently skipping the cue. Get a
# free key at https://www.pexels.com/api/ (no cost, generous rate limit). Fetched clips are cached
# to assets/broll/<tag>.mp4 on first use, so this only ever costs one API call per cue tag.
# PEXELS_API_KEY=

# Optional — second free B-roll source, tried when Pexels has no key or no result for a tag. Get a
# free key at https://pixabay.com/api/docs/.
# PIXABAY_API_KEY=

# Optional — when a suggested SFX cue has no matching file in assets/sfx/, fetch a short
# preview-quality sting from Freesound.org instead of silently skipping the cue. Get a free key at
# https://freesound.org/apiv2/apply/ (instant, no approval wait).
# FREESOUND_API_KEY=

# No shared default for fal.ai (AI-generated B-roll) by design — it's a PAID per-second API, so
# clients set their own key under Marketing Studio's 🔑 API Keys tab, billed to their own fal.ai
# account. There is intentionally no FAL_API_KEY env var here.

# Optional, opt-in — self-hosted transcription (faster-whisper) instead of Sarvam/OpenAI's Whisper
# API. No API key needed at all; takes priority over both when enabled. Free, but a real Python ML
# dependency (see the Dockerfile) rather than just another API call — off by default. See
# SETUP.md's "Self-hosted transcription" section for why this exists and its real tradeoffs
# (CPU-only inference is slow for large models; Tamil/Malayalam get Whisper's own word timing, not
# a per-language forced-alignment boost — no confirmed model exists for those two).
# WHISPER_LOCAL_ENABLED=true
# WHISPER_MODEL_SIZE=small

# Optional, opt-in — self-hosted transcription via AI4Bharat's IndicConformer, specifically for
# better Hindi/Tamil/Malayalam/etc. accuracy than generic Whisper, and no chunking/response-shape
# guessing unlike Sarvam. REPLACES Sarvam for the languages it covers when enabled
# (WHISPER_LOCAL_ENABLED above still takes priority over this if both are set). Heavier than
# faster-whisper (real PyTorch dependency, ~1.2GB) — see SETUP.md's "Self-hosted transcription"
# section, including the one real gap: no word-level timestamps from this model, only improved
# recognized text (word timing falls back to evenly-split approximation).
#
# Needs a Hugging Face access token — confirmed via a real build failure, not documented anywhere
# findable beforehand: this specific model repo is GATED. Create a free account at
# huggingface.co, visit https://huggingface.co/ai4bharat/indic-conformer-600m-multilingual and
# click "Agree and access repository", then generate a read-scoped token (Settings > Access
# Tokens). This HF_TOKEN is a Docker BUILD ARG (set it as a build-time variable in Coolify), not a
# runtime env var here — the model is downloaded and baked into the image at build time, not
# fetched per-request.
# AI4BHARAT_ENABLED=true
# (HF_TOKEN is set as a Coolify build variable, not here)

# Optional, opt-in — self-hosted STANDBY text-to-speech via AI4Bharat's Indic Parler-TTS, for the
# WhatsApp voice-to-voice reply feature (cloudflare-worker/worker.js's engineSarvamTts /
# engineDeliverReply, and backend/recovery.js's ported copy for the automated recovery ladder).
# Sarvam AI (SARVAM_API_KEY, configured as a Worker secret, not here) stays the PRIMARY TTS
# provider everywhere and is called directly from the Worker — this only matters as a fallback,
# via the new POST /synthesize-voice-reply route, for when Sarvam's call already failed or
# SARVAM_API_KEY isn't configured. See lib/ai4bharatTts.js and tts/synthesize_ai4bharat.py for what
# is and isn't verified about this model (no live test was possible in the dev sandbox this was
# built in — expect real CPU inference latency, several seconds to tens of seconds per reply).
# Needs the same gated-repo HF_TOKEN Docker build arg as AI4BHARAT_ENABLED above (this repo's
# gating status wasn't confirmed either way — see the Dockerfile comment).
# AI4BHARAT_TTS_ENABLED=true

