RENDER_WEBHOOK_SECRET=
# Runtime switch. The image must also be built with INSTALL_AI4BHARAT_TTS=true.
AI4BHARAT_TTS_ENABLED=false
AI4BHARAT_TTS_TIMEOUT_MS=6500
AI4BHARAT_STARTUP_TIMEOUT_MS=180000
AI4BHARAT_RESTART_COOLDOWN_MS=60000
PIPER_TTS_TIMEOUT_MS=2500
PORT=8787

# Optional Piper overrides
# PIPER_BIN=/opt/piper/piper
# PIPER_VOICES_DIR=/app/models/piper-voices
# PIPER_VOICE_MAP_JSON={"en":"en_US-lessac-medium","ml":"ml_IN-meera-medium","hi":"hi_IN-priyamvada-medium"}
