NOCODB_BASE=https://whizz.aiingo.com
NOCODB_TOKEN=your_nocodb_token_here
CLIENTS_TABLE=mxl33bg4wi70fqj
TZ=Asia/Dubai
RUN_NOW=0
# Optional — only needed by recovery.js, and only for clients with Settings → Voice → Voice
# Follow-ups turned on. Same Sarvam AI key as the Cloudflare Worker's SARVAM_API_KEY secret; leave
# unset to keep the recovery ladder text-only.
SARVAM_API_KEY=

# Optional — STANDBY for the same Voice Follow-ups feature. When Sarvam's TTS call above fails (or
# SARVAM_API_KEY isn't set), recovery.js falls back to the self-hosted AI4Bharat TTS model on the
# Marketing Studio render pipeline (see render-pipeline/lib/ai4bharatTts.js, gated behind that
# service's own AI4BHARAT_TTS_ENABLED). Same values as the Cloudflare Worker's
# MARKETING_RENDER_WEBHOOK_URL/_SECRET secrets — leave unset to skip the standby and stay
# Sarvam-or-text only.
MARKETING_RENDER_WEBHOOK_URL=
MARKETING_RENDER_WEBHOOK_SECRET=
